generator client {
  provider               = "prisma-client-js"
  output                 = "./src/generated/prisma"
  generatedFileExtension = "js"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model bookings {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String         @db.Uuid
  lawyer_id      String         @db.Uuid
  date           DateTime       @db.Timestamp(6)
  payment_status PaymentStatus  @default(pending)
  booking_status BookingStatus  @default(pending)
  notes          String?        @db.VarChar
  lawyer_profile lawyer_profile @relation(fields: [lawyer_id], references: [id])
  users          users          @relation(fields: [user_id], references: [id])
  documents      documents[]
  payments       payments?

  @@index([lawyer_id])
  @@index([user_id])
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  paid
  failed
}
