// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider               = "prisma-client-js"
  output                 = "./src/generated/prisma"
  generatedFileExtension = "js"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  LAWYER
  ADMIN
}

model User {
  id          String    @id @default(uuid())
  first_name  String
  second_name String
  email       String    @unique
  role        UserRole  @default(USER)
  dob         DateTime?
  created_at  DateTime  @default(now())
  deleted_at  DateTime?

  lawyerApplication LawyerApplication?
}

model LawyerApplication {
  id         String   @id @default(uuid())
  user_id    String   @unique
  file_url   String
  lsk_number String
  created_at DateTime @default(now())
  status     String

  user          User           @relation(fields: [user_id], references: [id])
  lawyerProfile LawyerProfile?
}

model LawyerProfile {
  id                    String   @id @default(uuid())
  lawyer_application_id String   @unique
  category              String
  phone_number          String
  description           String
  created_at            DateTime @default(now())
  experience            Int
  consultation_fee      Int
  is_active             Boolean  @default(true)

  lawyerApplication LawyerApplication @relation(fields: [lawyer_application_id], references: [id])
}
